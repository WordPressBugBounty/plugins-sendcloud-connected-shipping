msgid "Screenshot of Order Status Filter"
msgstr "Skærmbillede af filteret for ordrestatus"

#. translators: %1$s and %2$s wrap 'Save' button text in bold; the rest explains that Sendcloud will import orders with newly selected statuses
#: resources/views/wc-settings/dashboard/sendcloud-manage-synchronisation.php:431
#, php-format
msgid ""
"Click %1$sSave%2$s. Once saved, Sendcloud will automatically import orders "
"with the newly selected statuses during future imports."
msgstr ""
"Klik på %1$sGem%2$s. Fremover importerer Sendcloud automatisk ordrer "
"med de nyvalgte statusser."

#. translators: %1$s and %2$s wrap 'Important:' in bold; %3$s and %4$s wrap 'last 30 days' in bold; %5$s and %6$s wrap 'customer support' as a clickable link; %7$s and %8$s wrap 'CSV file' as a clickable link; the rest of the text explains order import behavior
#: resources/views/wc-settings/dashboard/sendcloud-manage-synchronisation.php:448
#, php-format
msgid ""
"%1$sImportant:%2$s When you modify your status filter, Sendcloud "
