msgstr "Integrationen er frakoblet"

#: includes/Controllers/Api/class-service-point-controller.php:61
msgid "Service points enabled successfully."
msgstr "Afhentningsstederne er aktiveret."

#: includes/Controllers/Api/class-service-point-controller.php:73
